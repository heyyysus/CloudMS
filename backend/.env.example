DATABASE_URL=postgresql://postgres:password@localhost:5433/myapp
LOG_LEVEL=info
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: ensured as an active admin user on startup (invite-only bootstrap)
ADMIN_EMAIL=admin@example.com
# Resend API key and sending address for outbound client email
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Cloud CMS <noreply@mail.yourdomain.com>
# Optional: address client replies should go to instead of the send-from address
MAIL_REPLY_TO=agency@yourdomain.com
# Cloudflare R2 (S3-compatible) bucket for policy attachments
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=policy-attachments
# Policy attachment upload limits
POLICY_ATTACHMENT_MAX_SIZE_MB=10
POLICY_ATTACHMENT_DAILY_LIMIT=100
