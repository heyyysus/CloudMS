# Owner role: schema push (db:push), role grants, seed and bootstrap all run
# as this role. Never used by the API, the scheduler, or the test suite.
DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5433/myapp
# Non-superuser `app` role: used by the API, the scheduler, and the test
# suite. Its password must match APP_DB_PASSWORD below (db:push's role grant
# step is what actually sets it; nothing derives one from the other).
DATABASE_URL=postgresql://app:password@localhost:5433/myapp
APP_DB_PASSWORD=password
# Max size of the app role's connection pool. Every in-flight request now
# pins one connection for its full duration (its row-level-security org
# context lives on a transaction, not a per-statement setting - see
# docs/multitenancy.md), so this also caps concurrent requests; check it
# against Postgres's own max_connections (100 by default) times the number of
# app containers, plus the scheduler's separate admin pool.
DB_POOL_MAX=20
LOG_LEVEL=info
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: ensured as a platform owner on startup (requirePlatformOwner - a
# deployment-wide capability, independent of any org membership). This is how
# you bootstrap the very first organization on an empty database: sign in as
# this address, then POST /organizations to create one and seat its admin.
PLATFORM_OWNER_EMAIL=admin@example.com
# Resend API key and sending address for outbound client email
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Cloud CMS <noreply@mail.yourdomain.com>
# Public URL of the frontend, used for the {{appUrl}} merge field in the
# welcome/invite email
APP_URL=https://cms.yourdomain.com
# Automated reminder scheduler. Runs in-process on every app container; the
# planner takes a Postgres advisory lock and the dispatcher claims work with
# SKIP LOCKED, so running several containers is safe with no extra config.
REMINDERS_ENABLED=true
REMINDER_TICK_MS=60000
# How far ahead reminders are queued. Rows exist days before they are due, so
# an outage shorter than this sends them late rather than not at all.
REMINDER_HORIZON_DAYS=7
# Catches policies created or edited during an outage; keep it small so a long
# gap can't blast out stale reminders.
REMINDER_LOOKBACK_DAYS=1
REMINDER_BATCH_SIZE=10
REMINDER_MAX_ATTEMPTS=3
# How long a claimed reminder can sit before another container reclaims it
REMINDER_CLAIM_TIMEOUT_MS=300000
# Cloudflare R2 (S3-compatible) bucket for policy attachments
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=policy-attachments
# Policy attachment upload limits
POLICY_ATTACHMENT_MAX_SIZE_MB=10
POLICY_ATTACHMENT_DAILY_LIMIT=100
