DATABASE_URL=postgresql://postgres:password@localhost:5433/myapp
LOG_LEVEL=info
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: ensured as an active admin user on startup (invite-only bootstrap)
ADMIN_EMAIL=admin@example.com
# Resend API key and sending address for outbound client email
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Cloud CMS <noreply@mail.yourdomain.com>
# Optional: address client replies should go to instead of the send-from address
MAIL_REPLY_TO=agency@yourdomain.com
