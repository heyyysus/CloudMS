{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // ES2022.Error only, for `new Error(msg, { cause })` - the runtime (Node
    // 24) has had it for years, and the lint rule here requires it. Not the
    // whole of ES2022, so nothing else silently starts type-checking.
    "lib": ["ES2020", "ES2022.Error"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
