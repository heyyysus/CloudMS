DATABASE_URL=postgresql://postgres:password@localhost:5433/myapp
LOG_LEVEL=info
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: ensured as an active admin user on startup (invite-only bootstrap)
ADMIN_EMAIL=admin@example.com
# Demo instance mode: exposes POST /auth/demo (unauthenticated admin sign-in,
# no Google) and reports true from GET /config. Never set this on a real
# instance - anyone can mint an admin account while it's on. It also refuses
# to start if any outbound-credential env var below (RESEND_API_KEY,
# MAIL_FROM, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_BUCKET_NAME) is set, and mail/attachment routes and the reminder
# scheduler answer 403 "Disabled in demo mode" instead of sending/storing
# anything.
DEMO_MODE=false
# Session lifetime for demo sign-ins, in minutes. Real (Google) sessions are
# unaffected - they always use the 7-day SESSION_TTL_MS.
DEMO_SESSION_TTL_MINUTES=240
# Per-table row ceiling enforced on create routes while DEMO_MODE=true, so one
# visitor can't fill the database. No effect outside demo mode.
DEMO_MAX_ROWS_PER_TABLE=5000
# Resend API key and sending address for outbound client email
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Cloud CMS <noreply@mail.yourdomain.com>
# Optional: address client replies should go to instead of the send-from address
MAIL_REPLY_TO=agency@yourdomain.com
# Public URL of the frontend, used for the {{appUrl}} merge field in the
# welcome/invite email
APP_URL=https://cms.yourdomain.com
# Agency name rendered into {{agentName}} on automated reminder sends, which
# have no logged-in agent behind them
AGENCY_NAME=Your Agency Name
# Automated reminder scheduler. Runs in-process on every app container; the
# planner takes a Postgres advisory lock and the dispatcher claims work with
# SKIP LOCKED, so running several containers is safe with no extra config.
REMINDERS_ENABLED=true
REMINDER_TICK_MS=60000
# IANA zone for the local hour reminders go out (Postgres does the DST math)
REMINDER_TIMEZONE=America/Chicago
REMINDER_SEND_HOUR=9
# How far ahead reminders are queued. Rows exist days before they are due, so
# an outage shorter than this sends them late rather than not at all.
REMINDER_HORIZON_DAYS=7
# Catches policies created or edited during an outage; keep it small so a long
# gap can't blast out stale reminders.
REMINDER_LOOKBACK_DAYS=1
REMINDER_BATCH_SIZE=10
REMINDER_MAX_ATTEMPTS=3
# How long a claimed reminder can sit before another container reclaims it
REMINDER_CLAIM_TIMEOUT_MS=300000
# Cloudflare R2 (S3-compatible) bucket for policy attachments
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=policy-attachments
# Policy attachment upload limits
POLICY_ATTACHMENT_MAX_SIZE_MB=10
POLICY_ATTACHMENT_DAILY_LIMIT=100
