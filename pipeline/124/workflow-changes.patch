           v=$(grep -oiE '^Verdict: *(approved|rejected)' "$f" | tail -1 | awk '{print tolower($2)}')
           [[ "$v" == "approved" || "$v" == "rejected" ]] || { echo "No verdict line in review.md"; exit 1; }
           echo "verdict=$v" >> "$GITHUB_OUTPUT"
