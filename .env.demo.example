# Template for the demo deployment's env file. Copy to .env.demo (gitignored)
# and fill in the real values before bringing up docker-compose.demo.yml.
#
# Deliberately omits RESEND_API_KEY, MAIL_FROM, MAIL_REPLY_TO, and every R2_*
# key - the demo sends no real email and stores no real attachments. This is
# enforced, not just convention: with DEMO_MODE=true the process refuses to
# boot if any of those are set, and the mail/storage seams answer 403
# regardless. Adding them back will stop the demo from starting.

# DEMO_MODE is also set directly in docker-compose.demo.yml's `environment:`,
# so it can't be lost by an incomplete env file, but set it here too.
DEMO_MODE=true
DEMO_SESSION_TTL_MINUTES=240
DEMO_MAX_ROWS_PER_TABLE=5000
DEMO_RESEED_INTERVAL_MINUTES=15
# Sign-ins per IP per rolling hour through POST /auth/demo. A speed bump
# against casual abuse, not a security control - see docs/demo-mode.md.
DEMO_SIGNIN_LIMIT_PER_HOUR=5

LOG_LEVEL=info

# Required at boot regardless of demo mode (see src/index.ts) even though
# /auth/demo doesn't use it - the server refuses to start without one.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public URL the demo is reachable at, used for the {{appUrl}} merge field.
APP_URL=https://demo.yourdomain.com

# Belt and braces: demo mode already stops the reminder scheduler from
# starting (jobs/scheduler.ts), so this is a second, explicit switch rather
# than the thing keeping the demo from emailing anyone.
REMINDERS_ENABLED=false
