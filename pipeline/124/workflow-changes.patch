+          STOP_REASON: ${{ steps.claude.outputs.stop_reason }}
         run: |
           set -euo pipefail
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
           f="pipeline/$ISSUE/review.md"
+          # always() so a cancellation or the 10-minute timeout doesn't throw away a review
